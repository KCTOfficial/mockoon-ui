{
  "name": "mockoon-cli-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts --port 7099\" \"vite\"",
    "dev:api": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts --port 7099",
    "dev:web": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build && esbuild server/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/server/index.mjs",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/server/index.mjs",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/server/index.mjs",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@mockoon/commons": "^9.5.0",
    "@mockoon/commons-server": "^9.5.0",
    "@monaco-editor/react": "^4.7.0",
    "@primer/octicons-react": "^19.41.0",
    "@types/uuid": "^10.0.0",
    "hono": "^4.13.13",
    "pm2": "^6.0.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "uuid": "^13.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@mockoon/cli": "^9.5.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
