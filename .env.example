# Dashboard login (static credentials). Copy to .env (or .env.local) and change the values.
# Only protects the UI and /api/* of this dashboard; mock servers stay publicly accessible.
MOCKOON_UI_USERNAME=admin
MOCKOON_UI_PASSWORD=change-me
# Random string used to sign session cookies, e.g. `openssl rand -base64 32`.
# Changing it logs everyone out.
MOCKOON_UI_AUTH_SECRET=freetofillanythingdoyouwantmustbestring

# Optional: force the Secure cookie flag (auto-enabled when x-forwarded-proto is https)
# MOCKOON_UI_COOKIE_SECURE=true
