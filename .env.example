# Everything here is optional: on first run the UI asks for the login, the UI port and the mock
# server port range, and saves them in config/settings.json. Values set here win over that file.
# Copy to .env (or .env.local) and restart the UI after changing it.

# Login override, e.g. to reset a forgotten password. Remove both to use the login from the setup.
# Only protects the UI and /api/* of this dashboard; mock servers stay publicly accessible.
# MOCKOON_UI_USERNAME=admin
# MOCKOON_UI_PASSWORD=change-me

# Secret used to sign session cookies (default: generated by the setup), e.g. `openssl rand -base64 32`.
# Changing it logs everyone out.
# MOCKOON_UI_AUTH_SECRET=

# UI port (default: from the setup, else 7001). Locks the port field in the setup.
# PORT=7001

# Ports mock servers may use (inclusive). Each environment needs its own port inside this range.
# Open the same range once in the firewall, e.g. `sudo ufw allow 7002:7020/tcp`.
# MOCKOON_PORT_RANGE=7002-7020

# Firewall the setup shows commands for: ufw, firewalld, windows or none (hide them).
# Unset = picked from the OS (Windows Firewall on Windows, ufw on Linux).
# Only a hint: Mockoon UI never changes the firewall itself.
# MOCKOON_FIREWALL=ufw

# Force the Secure cookie flag (auto-enabled when x-forwarded-proto is https)
# MOCKOON_UI_COOKIE_SECURE=true
